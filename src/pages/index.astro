---
import BaseLayout from '../layouts/BaseLayout.astro';
import {
  siYoutube,
  siSpotify,
  siApplemusic,
  siDeezer,
  siInstagram,
  siTiktok
} from 'simple-icons';

const socials = [
  { name: 'YouTube', url: 'https://www.youtube.com/channel/UCz-wOedKNRdpFHCN_Y97RpQ', icon: siYoutube },
  { name: 'Spotify', url: 'https://open.spotify.com/artist/27G6LoQrP8XRtJcaQShu3a?si=m_I1cw2DT2qpg4XiPf26dQ&nd=1&dlsi=85134dc153fe4f50', icon: siSpotify },
  { name: 'Apple Music', url: 'https://music.apple.com/us/artist/tolga-tüyel/1829393182', icon: siApplemusic },
  { name: 'Deezer', url: 'https://www.deezer.com/tr/artist/338210611', icon: siDeezer },
  { name: 'Instagram', url: 'https://www.instagram.com/tolga.tuyel/', icon: siInstagram },
  { name: 'TikTok', url: 'https://www.tiktok.com/@tolga.tuyel', icon: siTiktok }
];

const videos = [
  {
    title: 'Labirent',
    type: 'Resmi Video Klip',
    year: '2026',
    id: 'NhP-RROUSl8'
  },
  {
    title: 'Susmam',
    type: 'Resmi Video Klip',
    year: '2026',
    id: 'v8b2K9MUE1M'
  },
  {
    title: 'Boş Balad',
    type: 'Resmi Video Klip',
    year: '2026',
    id: '6jVCqlxbTA0'
  },
  {
    title: 'Karanlıkla Baş Başa',
    type: 'Lyrics Video',
    year: '2026',
    id: 'y0JOM3B0_Dg'
  },
  {
    title: 'Namütenahi',
    type: 'Resmi Video Klip',
    year: '2025',
    id: 'H6HGBZvG7do'
  },
  {
    title: 'Geceye Fısıldayan Kalp',
    type: 'Resmi Video Klip',
    year: '2025',
    id: 'SDw5H0Xk9jE'
  },
  {
    title: 'Sen Gidince',
    type: 'Resmi Video Klip',
    year: '2025',
    id: 'iqQQ17A5bBg'
  }
];

const acousticPerformances = [
  { title: "Patience (Guns N' Roses Cover)", id: 'e50pruJ6LC4', duration: 'PT4M31S', orientation: 'landscape' },
  { title: 'Big In Japan (Alphaville Cover)', id: 'xOZuQZStNn4', duration: 'PT3M15S', orientation: 'landscape' },
  { title: 'Boş Balad (Akustik Versiyon)', id: 'LI81Vzg1C-g', duration: 'PT3M21S', orientation: 'landscape' },
  { title: 'Sözlerimi Geri Alamam', id: 'zvvW2qbF59s', duration: 'PT3M43S', orientation: 'portrait' },
  { title: 'Fırt Emin (Yaşar Kurt)', id: 'A7X6yYeylxs', duration: 'PT2M35S', orientation: 'portrait' },
  { title: 'Aynalı Kemer (Barış Manço)', id: 'TKwM4Lw8-gQ', duration: 'PT3M2S', orientation: 'portrait' },
  { title: 'Ruhum (Yaşar Kurt Cover)', id: 'qBE6Sl-sBV8', duration: 'PT2M35S', orientation: 'portrait' },
  { title: 'Tamirci Çırağı (Cem Karaca Cover)', id: 'IElHNiD0Ic8', duration: 'PT5M48S', orientation: 'portrait' }
];

const gallery = [
  {
    src: '/images/gallery/tolga-tuyel-warm-portrait.jpg',
    webp: '/images/gallery/tolga-tuyel-warm-portrait.webp',
    alt: 'Tolga Tüyel sıcak tonlu stüdyo portresinde',
    width: 1365,
    height: 2048,
    orientation: 'portrait'
  },
  {
    src: '/images/gallery/tolga-tuyel-shadow-portrait.jpg',
    webp: '/images/gallery/tolga-tuyel-shadow-portrait.webp',
    alt: 'Tolga Tüyel siyah beyaz stüdyo portresinde gülümserken',
    width: 2048,
    height: 1365,
    orientation: 'landscape'
  },
  {
    src: '/images/gallery/tolga-tuyel-blue-portrait.jpg',
    webp: '/images/gallery/tolga-tuyel-blue-portrait.webp',
    alt: 'Tolga Tüyel mavi tonlu stüdyo portresinde',
    width: 1365,
    height: 2047,
    orientation: 'portrait'
  },
  {
    src: '/images/gallery/tolga-tuyel-microphone.jpg',
    webp: '/images/gallery/tolga-tuyel-microphone.webp',
    alt: 'Tolga Tüyel mikrofonla siyah beyaz sahne portresinde',
    width: 2048,
    height: 1365,
    orientation: 'landscape'
  }
];

const siteURL = Astro.site ?? new URL('https://tolgatuyel.com');
const artistURL = new URL('/#artist', siteURL).href;
const websiteURL = new URL('/#website', siteURL).href;
const structuredData = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Person',
      '@id': artistURL,
      name: 'Tolga Tüyel',
      url: new URL('/', siteURL).href,
      image: [
        new URL('/images/tolga-tuyel-hero.jpg', siteURL).href,
        ...gallery.map((image) => new URL(image.src, siteURL).href)
      ],
      jobTitle: 'Rock Müzisyeni',
      description: 'Türk rock müzisyeni, söz yazarı ve besteci Tolga Tüyel.',
      sameAs: socials.map((social) => social.url),
      subjectOf: acousticPerformances.map((video) => ({ '@id': `${new URL('/', siteURL).href}#acoustic-${video.id}` }))
    },
    {
      '@type': 'WebSite',
      '@id': websiteURL,
      url: new URL('/', siteURL).href,
      name: 'Tolga Tüyel | Resmi Web Sitesi',
      inLanguage: 'tr-TR',
      publisher: { '@id': artistURL }
    },
    ...acousticPerformances.map((video) => ({
      '@type': 'VideoObject',
      '@id': `${new URL('/', siteURL).href}#acoustic-${video.id}`,
      name: video.title,
      description: `${video.title}, Tolga Tüyel akustik performansı.`,
      thumbnailUrl: `https://i.ytimg.com/vi/${video.id}/maxresdefault.jpg`,
      embedUrl: `https://www.youtube-nocookie.com/embed/${video.id}`,
      contentUrl: `https://www.youtube.com/watch?v=${video.id}`,
      duration: video.duration,
      inLanguage: 'tr-TR',
      creator: { '@id': artistURL }
    }))
  ]
};
---

<BaseLayout structuredData={structuredData}>
  <a class="skip-link" href="#main-content">İçeriğe geç</a>
  <header class="site-header" id="top">
    <a class="wordmark" href="#top" aria-label="Tolga Tüyel ana sayfa">TOLGA <span>TÜYEL</span></a>
    <button class="menu-toggle" type="button" aria-label="Menüyü aç" aria-expanded="false" aria-controls="main-nav">
      <i aria-hidden="true"></i><i aria-hidden="true"></i>
    </button>
    <nav id="main-nav" aria-label="Ana menü">
      <a href="#muzik">Müzik</a>
      <a href="#videolar">Klipler</a>
      <a href="#akustik">Akustik</a>
      <a href="#galeri">Galeri</a>
      <a href="#hakkinda">Hakkında</a>
    </nav>
  </header>

  <main id="main-content" tabindex="-1">
    <section class="hero" aria-label="Tolga Tüyel">
      <img
        class="hero-photo-placeholder"
        src="/images/tolga-tuyel-hero.jpg"
        alt="Rock müzisyeni Tolga Tüyel sahnede mikrofonuyla"
        width="2048"
        height="1365"
        fetchpriority="high"
        decoding="async"
      />
      <div class="hero-overlay"></div>
      <div class="hero-copy">
        <h1><span>TOLGA</span> <em>TÜYEL</em></h1>
        <div class="hero-actions">
          <a class="btn btn-primary" href="#muzik">DİNLE <span>↗</span></a>
          <a class="btn btn-outline" href="#videolar">KLİPLER</a>
        </div>
      </div>
    </section>

    <section class="ticker" aria-label="Güncel duyuru">
      <div class="ticker-track">
        <div class="ticker-group">
          <span>YENİ YAYIN — LABİRENT — ŞİMDİ TÜM DİJİTAL PLATFORMLARDA</span><b>✦</b>
          <span>YENİ YAYIN — LABİRENT — ŞİMDİ TÜM DİJİTAL PLATFORMLARDA</span><b>✦</b>
          <span>YENİ YAYIN — LABİRENT — ŞİMDİ TÜM DİJİTAL PLATFORMLARDA</span><b>✦</b>
        </div>
        <div class="ticker-group" aria-hidden="true">
          <span>YENİ YAYIN — LABİRENT — ŞİMDİ TÜM DİJİTAL PLATFORMLARDA</span><b>✦</b>
          <span>YENİ YAYIN — LABİRENT — ŞİMDİ TÜM DİJİTAL PLATFORMLARDA</span><b>✦</b>
          <span>YENİ YAYIN — LABİRENT — ŞİMDİ TÜM DİJİTAL PLATFORMLARDA</span><b>✦</b>
        </div>
      </div>
    </section>

    <section class="listen section" id="muzik">
      <div class="section-heading">
        <h2>SESİ TAKİP ET.</h2>
      </div>
      <p class="listen-intro">Yeni yayınları ve tüm diskografiyi dijital platformlardan dinle.</p>
      <div class="platform-list">
        {socials.map((social) => (
          <a class="platform-link" href={social.url} target="_blank" rel="noopener noreferrer" aria-label={`${social.name} üzerinde Tolga Tüyel’i dinle`}>
            <span class="platform-logo" aria-hidden="true">
              <svg viewBox="0 0 24 24">
                <path d={social.icon.path} fill={`#${social.icon.hex}`} />
              </svg>
            </span>
            <span class="platform-name">{social.name}</span>
            <span class="platform-action">DİNLE <b>↗</b></span>
          </a>
        ))}
      </div>
    </section>

    <section class="videos section" id="videolar">
      <div class="section-heading split-heading">
        <div>
          <h2>KLİPLER</h2>
        </div>
      </div>
      <div class="video-list">
        {videos.map((video) => (
          <article class="video-card">
            <div class="video-frame">
              <iframe
                src={`https://www.youtube-nocookie.com/embed/${video.id}`}
                title={`${video.title} - Tolga Tüyel`}
                loading="lazy"
                referrerpolicy="strict-origin-when-cross-origin"
                allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
                allowfullscreen
              ></iframe>
            </div>
            <div class="video-meta">
              <p>{video.type} <span>/</span> {video.year}</p>
              <h3>{video.title}</h3>
              <a href={`https://www.youtube.com/watch?v=${video.id}`} target="_blank" rel="noopener noreferrer">YOUTUBE’DA İZLE <span>↗</span></a>
            </div>
          </article>
        ))}
      </div>
    </section>

    <section class="acoustic section" id="akustik">
      <div class="section-heading acoustic-heading">
        <div>
          <h2>AKUSTİK</h2>
          <p>Canlı ve akustik performanslar. Bir videoya dokun, dinlemeye başla.</p>
        </div>
        <div class="acoustic-controls" aria-label="Akustik performans kontrolleri">
          <button class="acoustic-prev" type="button" aria-label="Önceki akustik performans">←</button>
          <button class="acoustic-next" type="button" aria-label="Sonraki akustik performans">→</button>
        </div>
      </div>
      <div class="acoustic-marquee" aria-label="Tolga Tüyel akustik performansları" tabindex="0">
        <div class="acoustic-track">
          <div class="acoustic-group">
            {acousticPerformances.map((video) => (
              <button
                class={`acoustic-card ${video.orientation}`}
                type="button"
                data-acoustic-video={video.id}
                data-acoustic-title={video.title}
                aria-label={`${video.title} akustik performansını oynat`}
              >
                <img
                  src={`https://i.ytimg.com/vi/${video.id}/maxresdefault.jpg`}
                  alt=""
                  width="1280"
                  height="720"
                  loading="lazy"
                  decoding="async"
                />
                <span class="acoustic-shade" aria-hidden="true"></span>
                <span class="acoustic-play" aria-hidden="true"><i></i></span>
                <span class="acoustic-card-copy">
                  <strong>{video.title}</strong>
                </span>
              </button>
            ))}
          </div>
        </div>
      </div>
    </section>

    <section class="gallery section" id="galeri">
      <div class="section-heading split-heading">
        <div>
          <h2>GALERİ</h2>
        </div>
        <div class="gallery-controls" aria-label="Galeri kontrolleri">
          <button class="gallery-prev" type="button" aria-label="Önceki fotoğraflar">←</button>
          <button class="gallery-next" type="button" aria-label="Sonraki fotoğraflar">→</button>
        </div>
      </div>
      <div class="gallery-strip" tabindex="0">
        {gallery.map((image, index) => (
          <figure class={`gallery-item ${image.orientation} item-${index + 1}`}>
            <picture class="gallery-media">
              <source srcset={image.webp} type="image/webp" />
              <img
                src={image.src}
                alt={image.alt}
                width={image.width}
                height={image.height}
                loading="lazy"
                decoding="async"
              />
            </picture>
          </figure>
        ))}
      </div>
    </section>

    <section class="about section" id="hakkinda">
      <p class="eyebrow">HAKKINDA</p>
      <div class="about-grid">
        <h2>TOLGA<br /><span>TÜYEL</span></h2>
        <div class="about-copy">
          <p>Tolga Tüyel’in müzik serüveni 1991’de gitarla tanışmasıyla başladı. Rock müziğin güçlü ve duygusal etkisi onu derinden etkiledi. Guns N’ Roses, Metallica, Nirvana, Iron Maiden ve The Doors gibi gruplar, müzikal kimliğinin temel taşları oldu.</p>
          <p>Kumsallarda başlayan bu yolculuk, Kadıköy ve Taksim’in canlı sahnelerine uzandı. Cover gruplarıyla sahne deneyimi kazanırken, kendi bestelerini üretmeyi hiç bırakmadı. Ancak Türkiye’de rock müziğin karşılaştığı zorluklar ve ekonomik koşullar, onu bir süreliğine müzikten uzaklaştırdı ve kurumsal hayata yöneltti.</p>
          <p>Bugün ise 30 yıllık birikimiyle müziğe dönüş yapan Tolga Tüyel, şarkılarını geniş kitlelere ulaştırmayı hedefliyor. Eserleri çok katmanlı yapısıyla, dinleyiciye kendi iç yolculuğuna göre anlam sunuyor.</p>
          <p>Solo kariyerini başlatan Tüyel’in ilk teklisi “Sen Gidince”, yıllar önce yazılmış ve zamanla yeniden şekillenmiş bir parça. Prodüktör Kutay Yavuz’la birlikte modern bir rock sound’una kavuşan şarkının en zor kısmı, yıllarca içe sinmeyen gitar solosuydu. Kayıt gününün son saatlerinde, yoğun bir çalışmayla tamamlandı.</p>
          <p>İkinci teklisi “Geceye Fısıldayan Kalp” ve yayınlanmak üzere olan üçüncü teklisi “Namütenahi”de ise prodüktör koltuğunda İlkay Özboyar yer aldı.</p>
          <p>Kurumsal alanda genel müdürlük yapan Tolga Tüyel için müzik, hiçbir zaman sadece bir hobi olmadı. “Sen Gidince” ile başlayan bu yeni dönem, onun iç dünyasını müziğe dönüştürdüğü samimi ve kararlı bir çıkışı temsil ediyor.</p>
        </div>
      </div>
    </section>
  </main>

  <footer>
    <div class="footer-bottom">
      <p>© {new Date().getFullYear()} TOLGA TÜYEL</p>
      <div>{socials.map((social) => <a href={social.url} target="_blank" rel="noopener noreferrer">{social.name}</a>)}</div>
      <p class="mifer-credit">DESIGN BY <a href="https://miferdigital.com" target="_blank" rel="noopener noreferrer">MIFER</a></p>
    </div>
  </footer>

  <dialog class="acoustic-dialog" aria-labelledby="acoustic-dialog-title">
    <div class="acoustic-dialog-shell">
      <button class="acoustic-close" type="button" aria-label="Videoyu kapat">KAPAT <span aria-hidden="true">×</span></button>
      <p class="eyebrow">AKUSTİK PERFORMANS</p>
      <h3 id="acoustic-dialog-title"></h3>
      <div class="acoustic-player">
        <iframe
          src="about:blank"
          title="Tolga Tüyel akustik performansı"
          referrerpolicy="strict-origin-when-cross-origin"
          allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
          allowfullscreen
        ></iframe>
      </div>
    </div>
  </dialog>

  <script>
    const root = document.documentElement;
    let lastViewportWidth = window.innerWidth;
    const lockMobileViewportHeight = () => {
      if (!window.matchMedia('(max-width: 760px)').matches) {
        root.style.removeProperty('--mobile-viewport-height');
        return;
      }
      const viewportHeight = Math.round(window.visualViewport?.height ?? window.innerHeight);
      root.style.setProperty('--mobile-viewport-height', `${viewportHeight}px`);
    };
    lockMobileViewportHeight();
    window.addEventListener('resize', () => {
      const nextWidth = window.innerWidth;
      if (Math.abs(nextWidth - lastViewportWidth) < 40) return;
      lastViewportWidth = nextWidth;
      window.requestAnimationFrame(lockMobileViewportHeight);
    }, { passive: true });
    window.addEventListener('orientationchange', () => window.requestAnimationFrame(lockMobileViewportHeight), { passive: true });

    const menuButton = document.querySelector('.menu-toggle');
    const header = document.querySelector('.site-header');
    menuButton?.addEventListener('click', () => {
      const open = header?.classList.toggle('menu-open');
      menuButton.setAttribute('aria-expanded', String(open));
      menuButton.setAttribute('aria-label', open ? 'Menüyü kapat' : 'Menüyü aç');
    });
    document.querySelectorAll('nav a').forEach((link) => link.addEventListener('click', () => {
      header?.classList.remove('menu-open');
      menuButton?.setAttribute('aria-expanded', 'false');
      menuButton?.setAttribute('aria-label', 'Menüyü aç');
    }));
    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && header?.classList.contains('menu-open')) {
        header.classList.remove('menu-open');
        menuButton?.setAttribute('aria-expanded', 'false');
        menuButton?.setAttribute('aria-label', 'Menüyü aç');
        menuButton?.focus();
      }
    });

    const strip = document.querySelector('.gallery-strip');
    const galleryItems = strip ? Array.from(strip.querySelectorAll('.gallery-item')) : [];
    const galleryItemLeft = (item) => {
      if (!(strip instanceof HTMLElement) || !(item instanceof HTMLElement)) return 0;
      return item.getBoundingClientRect().left - strip.getBoundingClientRect().left + strip.scrollLeft;
    };
    const moveGallery = (direction) => {
      if (!(strip instanceof HTMLElement) || galleryItems.length === 0) return;
      const currentLeft = strip.scrollLeft;
      const positions = galleryItems.map(galleryItemLeft);
      const target = direction > 0
        ? positions.find((position) => position > currentLeft + 8) ?? positions[positions.length - 1]
        : [...positions].reverse().find((position) => position < currentLeft - 8) ?? positions[0];
      strip.scrollTo({
        left: target ?? 0,
        behavior: window.matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth'
      });
    };
    document.querySelector('.gallery-next')?.addEventListener('click', () => moveGallery(1));
    document.querySelector('.gallery-prev')?.addEventListener('click', () => moveGallery(-1));

    const acousticStrip = document.querySelector('.acoustic-marquee');
    const acousticCards = acousticStrip ? Array.from(acousticStrip.querySelectorAll('.acoustic-card')) : [];
    const acousticCardLeft = (card) => {
      if (!(acousticStrip instanceof HTMLElement) || !(card instanceof HTMLElement)) return 0;
      return card.getBoundingClientRect().left - acousticStrip.getBoundingClientRect().left + acousticStrip.scrollLeft;
    };
    const moveAcoustic = (direction) => {
      if (!(acousticStrip instanceof HTMLElement) || acousticCards.length === 0) return;
      const currentLeft = acousticStrip.scrollLeft;
      const rawPositions = acousticCards.map(acousticCardLeft);
      const leadingInset = rawPositions[0] ?? 0;
      const positions = rawPositions.map((position) => Math.max(0, position - leadingInset));
      const target = direction > 0
        ? positions.find((position) => position > currentLeft + 8) ?? positions[positions.length - 1]
        : [...positions].reverse().find((position) => position < currentLeft - 8) ?? positions[0];
      acousticStrip.scrollTo({
        left: target ?? 0,
        behavior: window.matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth'
      });
    };
    document.querySelector('.acoustic-next')?.addEventListener('click', () => moveAcoustic(1));
    document.querySelector('.acoustic-prev')?.addEventListener('click', () => moveAcoustic(-1));

    const acousticDialog = document.querySelector('.acoustic-dialog');
    const acousticFrame = acousticDialog?.querySelector('iframe');
    const acousticTitle = acousticDialog?.querySelector('#acoustic-dialog-title');
    document.querySelectorAll('[data-acoustic-video]').forEach((card) => {
      card.addEventListener('click', () => {
        const id = card.getAttribute('data-acoustic-video');
        const title = card.getAttribute('data-acoustic-title') ?? 'Akustik performans';
        if (!id || !(acousticDialog instanceof HTMLDialogElement) || !(acousticFrame instanceof HTMLIFrameElement)) return;
        if (acousticTitle) acousticTitle.textContent = title;
        acousticFrame.title = `${title} - Tolga Tüyel`;
        acousticFrame.src = `https://www.youtube-nocookie.com/embed/${id}?autoplay=1&rel=0`;
        acousticDialog.showModal();
      });
    });
    acousticDialog?.querySelector('.acoustic-close')?.addEventListener('click', () => acousticDialog.close());
    acousticDialog?.addEventListener('click', (event) => {
      if (event.target === acousticDialog) acousticDialog.close();
    });
    acousticDialog?.addEventListener('close', () => {
      if (acousticFrame instanceof HTMLIFrameElement) acousticFrame.src = 'about:blank';
    });
  </script>

  <style is:global>
    :root { --yellow:#f4d800; --ink:#0d0d0d; --paper:#f0eee8; --grey:#282828; }
    * { box-sizing:border-box; }
    html { scroll-behavior:smooth; scroll-padding-top:82px; background:var(--ink); -webkit-text-size-adjust:100%; text-size-adjust:100%; }
    body { min-width:320px; margin:0; background:var(--ink); color:var(--paper); font-family:Manrope, Arial, sans-serif; overflow-x:hidden; }
    button { font:inherit; }
    a { color:inherit; text-decoration:none; }
    :focus-visible { outline:3px solid var(--yellow); outline-offset:4px; }
    .skip-link { position:fixed; z-index:100; top:10px; left:10px; padding:12px 16px; background:var(--yellow); color:var(--ink); font:700 12px/1 'DM Mono',monospace; transform:translateY(-150%); transition:transform .2s; }
    .skip-link:focus { transform:translateY(0); }
    .site-header { height:82px; padding:0 clamp(22px,4vw,64px); display:flex; align-items:center; justify-content:space-between; position:sticky; top:0; z-index:20; background:rgba(13,13,13,.93); border-bottom:1px solid rgba(255,255,255,.12); backdrop-filter:blur(14px); }
    .wordmark { font-family:'Archivo Black',Arial,sans-serif; letter-spacing:-1.5px; font-size:20px; line-height:.85; white-space:nowrap; }
    .wordmark span { color:var(--yellow); }
