---
const {
  title = 'Tolga Tüyel | Resmi Web Sitesi',
  description = 'Rock müzisyeni Tolga Tüyel’in resmi web sitesi. Yeni şarkıları, video klipleri, müzik platformları ve sanatçı biyografisini keşfedin.',
  image = '/images/tolga-tuyel-hero.jpg',
  imageAlt = 'Tolga Tüyel sahne portresi',
  type = 'website',
  noindex = false,
  structuredData
} = Astro.props;

const canonicalURL = Astro.site ? new URL(Astro.url.pathname, Astro.site) : null;
const imageURL = Astro.site ? new URL(image, Astro.site) : image;
---
<!doctype html>
<html lang="tr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="description" content={description} />
    <meta name="author" content="Tolga Tüyel" />
    <meta name="robots" content={noindex ? 'noindex, nofollow' : 'index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1'} />
    <meta name="googlebot" content={noindex ? 'noindex, nofollow' : 'index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1'} />
    <meta name="referrer" content="strict-origin-when-cross-origin" />
    <meta name="theme-color" content="#0c0c0c" />
    <meta name="color-scheme" content="dark" />

    {canonicalURL && <link rel="canonical" href={canonicalURL} />}
    {canonicalURL && <link rel="alternate" hreflang="tr" href={canonicalURL} />}
    {canonicalURL && <link rel="alternate" hreflang="x-default" href={canonicalURL} />}

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="preload" as="image" href="/images/tolga-tuyel-hero.jpg" fetchpriority="high" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Archivo+Black&family=DM+Mono:wght@400;500&family=Manrope:wght@400;500;600;700;800&display=swap" rel="stylesheet" />

    <meta property="og:locale" content="tr_TR" />
    <meta property="og:type" content={type} />
    <meta property="og:site_name" content="Tolga Tüyel" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {canonicalURL && <meta property="og:url" content={canonicalURL} />}
    <meta property="og:image" content={imageURL} />
    <meta property="og:image:width" content="2048" />
    <meta property="og:image:height" content="1365" />
    <meta property="og:image:alt" content={imageAlt} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageURL} />
    <meta name="twitter:image:alt" content={imageAlt} />

    <title>{title}</title>
    {structuredData && <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />}
  </head>
  <body>
    <slot />
  </body>
</html>
